{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "app.norr.windows",
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
