{
  "name": "norr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/native"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @norr/web --",
    "build": "npm run build --workspace @norr/web",
    "preview": "npm run preview --workspace @norr/web --",
    "typecheck": "npm run typecheck --workspace @norr/web",
    "dev:mac": "npm run dev --workspace @norr/native",
    "build:mac": "npm run build --workspace @norr/native",
    "build:mac:p4": "npm run build --workspace @norr/native -- macos --polestar4-test",
    "build:mac:p4-demo": "npm run build:p4-demo --workspace @norr/native",
    "dev:windows": "npm run dev --workspace @norr/native",
    "build:windows:p4": "npm run build --workspace @norr/native -- windows --polestar4-test",
    "build:windows": "npm run build --workspace @norr/native -- windows",
    "build:android": "npm run build --workspace @norr/native -- android",
    "build:harmonyos": "node apps/harmonyos/scripts/build.mjs",
    "build:ios": "npm run build --workspace @norr/native -- ios",
    "build:ios:p4": "npm run build --workspace @norr/native -- ios --device --polestar4-test",
    "build:ios:unsigned": "npm run build --workspace @norr/native -- ios --device",
    "build:watch": "node apps/native/scripts/build-watch.mjs",
    "check:native": "cargo test --workspace"
  }
}
